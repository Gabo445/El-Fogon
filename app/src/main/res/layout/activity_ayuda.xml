<?xml version="1.0" encoding="utf-8"?>
<!-- "Ayuda y soporte": formas de contacto y preguntas frecuentes. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fogonBgLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Ayuda y soporte"
                android:textColor="@color/fogonBlack"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿En qué podemos ayudarte?"
                    android:textColor="@color/fogonBlack"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Encuentra respuestas rápidas más abajo o escríbenos: con gusto te ayudamos."
                    android:textColor="@color/fogonGrayText"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:text="Contáctanos"
                    android:textColor="@color/fogonBlack"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Aquí el código pone WhatsApp y el correo -->
                <LinearLayout
                    android:id="@+id/contenedorContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Si nos escribes por un pedido, incluye su número (por ejemplo #012) para ayudarte más rápido."
                    android:textColor="@color/fogonGrayText"
                    android:textSize="11sp" />

                <!-- Aquí el código pone las secciones con sus preguntas -->
                <LinearLayout
                    android:id="@+id/contenedorPreguntas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvVersionApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:textColor="@color/fogonGrayText"
                    android:textSize="11sp"
                    tools:text="El Fogón · Versión 1.0\nGracias por pedir con nosotros." />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</RelativeLayout>