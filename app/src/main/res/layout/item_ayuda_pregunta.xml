<?xml version="1.0" encoding="utf-8"?>
<!-- Una pregunta frecuente. Al tocarla se despliega la respuesta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPregunta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/fogonBlack"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="¿Cómo hago un pedido?" />

        <!-- La flecha apunta hacia abajo (cerrada) y se voltea hacia arriba al abrir -->
        <ImageView
            android:id="@+id/ivFlechaPregunta"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:rotation="90"
            android:src="@drawable/ic_perfil_flecha"
            android:tint="@color/fogonRed" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/fogonGrayText"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Aquí va la respuesta." />
</LinearLayout>