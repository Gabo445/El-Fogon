<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de acción en Privacidad y seguridad: ícono, título, explicación, estado opcional y flecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_perfil_icono">

        <ImageView
            android:id="@+id/ivIconoFila"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:tint="@color/fogonRed"
            tools:src="@drawable/ic_pago_candado" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fogonBlack"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Cambiar contraseña" />

        <TextView
            android:id="@+id/tvSubtituloFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fogonGrayText"
            android:textSize="12sp"
            tools:text="Te enviamos un enlace a tu correo" />
    </LinearLayout>

    <!-- Solo se usa en la fila de Ubicación (Permitida / No permitida) -->
    <TextView
        android:id="@+id/tvEstadoFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_pedido_chip"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Permitida" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_perfil_flecha"
        android:tint="@color/fogonBlack" />
</LinearLayout>