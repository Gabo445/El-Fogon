<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <CheckBox
        android:id="@+id/cbExtra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/fogonRed"
        android:text="" />

    <TextView
        android:id="@+id/tvNombreExtra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/fogonBlack"
        android:textSize="14sp"
        tools:text="Queso extra" />

    <TextView
        android:id="@+id/tvPrecioExtra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/fogonGrayText"
        android:textSize="14sp"
        tools:text="$1.00" />

</LinearLayout>