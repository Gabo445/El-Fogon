<?xml version="1.0" encoding="utf-8"?>
<!-- "Direcciones guardadas": muestra la dirección que tienes guardada y dónde queda en el mapa. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fogonBgLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Direcciones guardadas"
                android:textColor="@color/fogonBlack"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Se ve un instante mientras llega la dirección desde Firestore -->
            <TextView
                android:id="@+id/tvCargandoDirecciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="Cargando tu dirección…"
                android:textColor="@color/fogonGrayText"
                android:textSize="14sp" />

            <!-- Cuando SÍ hay una dirección guardada -->
            <ScrollView
                android:id="@+id/scrollDireccion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <!-- Tarjeta con la dirección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_white"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_pago_pin"
                                android:tint="@color/fogonRed" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Dirección de entrega"
                                android:textColor="@color/fogonGrayText"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvZonaGuardada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/fogonBlack"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Soyapango" />

                        <TextView
                            android:id="@+id/tvDireccionEspecificaGuardada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/fogonGrayText"
                            android:textSize="14sp"
                            tools:text="Colonia Las Margaritas, pasaje 3, casa 12" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/fogonBorderGray" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_pago_moto"
                                android:tint="@color/fogonRed" />

                            <TextView
                                android:id="@+id/tvTiempoEstimadoGuardado"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textColor="@color/fogonBlack"
                                android:textSize="13sp"
                                tools:text="Entrega estimada: 15 - 25 min" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- El mapa con la ubicación guardada -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Tu ubicación en el mapa"
                        android:textColor="@color/fogonBlack"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/frameMapaGuardado"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_pedido_mapa"
                        android:clipToOutline="true">

                        <WebView
                            android:id="@+id/webViewUbicacion"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Solo se ve si la dirección se guardó sin GPS (sin coordenadas) -->
                        <TextView
                            android:id="@+id/tvSinMapa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text="Esta dirección se guardó sin ubicación en el mapa.\nEdítala y toca “Usar mi ubicación” para verla aquí."
                            android:textColor="@color/fogonGrayText"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btnVerEnGoogleMaps"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_perfil_cerrar_sesion"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Ver en Google Maps"
                        android:textColor="@color/fogonRed"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnEditarDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Editar dirección"
                        android:textAllCaps="false"
                        android:textColor="@color/fogonWhite"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>

            <!-- Cuando todavía NO hay ninguna dirección guardada -->
            <LinearLayout
                android:id="@+id/layoutSinDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aún no tienes una dirección guardada"
                    android:textColor="@color/fogonBlack"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Agrega dónde quieres recibir tus pedidos."
                    android:textColor="@color/fogonGrayText"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnAgregarDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Agregar dirección"
                    android:textAllCaps="false"
                    android:textColor="@color/fogonWhite"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>